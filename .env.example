# Copy to .env and fill in real values. .env is gitignored.

# --- Scraping (DuckDuckGo search via `ddgs`) ---
# Scraping is keyless and browser-free: each platform runs a `site:<domain>`
# DuckDuckGo search. No login, no API keys, no Chromium install.
VOC_DDGS_MAX_RESULTS=10
VOC_DDGS_TIMEOUT_S=5
VOC_DDGS_REGION=us-en
VOC_DDGS_BACKEND=auto

# --- LLM / analysis (optional) ---
# If a provider key is configured, the report's executive summary + improvement
# suggestions and the gather agent are LLM-generated; otherwise a deterministic
# rule-based fallback is used.
#
# Default provider is Anthropic (install with `uv sync --extra llm`):
ANTHROPIC_API_KEY=
#
# To use a free model (e.g. Qwen) via any OpenAI-compatible endpoint, set:
#   VOC_LLM_PROVIDER=openai
#   VOC_LLM_BASE_URL=https://openrouter.ai/api/v1   # or local Ollama: http://localhost:11434/v1
#   VOC_LLM_API_KEY=sk-or-...                        # OpenRouter key (omit for keyless Ollama)
#   VOC_LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct:free   # check openrouter.ai/models?q=qwen
#   VOC_AGENT_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
VOC_LLM_PROVIDER=anthropic
VOC_LLM_BASE_URL=
VOC_LLM_API_KEY=
VOC_LLM_TIMEOUT_S=60

# --- Runtime ---
LOG_LEVEL=INFO
DATA_DIR=./data
