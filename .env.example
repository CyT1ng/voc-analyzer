# Copy to .env and fill in real values. .env is gitignored.

# --- Scraping ---
# Scraping uses Playwright (a headless browser) against public pages, so no
# platform API keys are required. Run `uv run playwright install chromium` once.
VOC_HEADLESS=true
# Optional: path to a persistent browser profile dir. Point it at a profile
# where you have logged into TikTok / Instagram / X to scrape those platforms.
VOC_BROWSER_PROFILE=
VOC_SCRAPE_TIMEOUT_MS=30000
VOC_MAX_SCROLLS=10

# --- LLM / analysis (optional) ---
# If set, the report's improvement suggestions are LLM-generated; otherwise a
# deterministic rule-based fallback is used. Install with `uv sync --extra llm`.
ANTHROPIC_API_KEY=

# --- Runtime ---
LOG_LEVEL=INFO
DATA_DIR=./data
